@page "/signin"

<PageTitle>Sign in</PageTitle>

<div class="row justify-content-center">
    <div class="col col-sm-8 col-md-7 col-lg-6 col-xl-5">
        <EditForm Model="loginModel" OnValidSubmit="AttemptLogin">
            <DataAnnotationsValidator />

            <Card Class="shadow">
                <CardHeader>
                    <h1>Sign in</h1>
                </CardHeader>
                <CardBody>
                    <div class="row justify-content-center g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <TextInput type="text" @bind-Value="loginModel.Email" id="loginInputEmail" placeholder="name@example.com" />
                                <label for="loginInputEmail" class="form-label">Email</label>
                                <ValidationMessage For="@(() => loginModel.Email)" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <TextInput type="password" @bind-Value="loginModel.Password" id="loginInputPassword" placeholder="Password" />
                                <label for="loginInputPassword" class="form-label">Password</label>
                                <ValidationMessage For="@(() => loginModel.Password)" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                            <Button Type="ButtonType.Submit"
                                    Color="ButtonColor.Secondary"
                                    Loading="spinnerVisible"
                                    Disabled="spinnerVisible"
                                    LoadingText="Logging in"
                                    Class="w-100">
                                Login
                            </Button>
                        </div>
                        <div class="col-12">
                            <div class="row align-items-center">
                                <div class="col">
                                    <hr class="m-0">
                                </div>
                                <div class="col-auto p-0">
                                    <h6 class="text-center m-0">Or sign in using Oauth</h6>
                                </div>
                                <div class="col">
                                    <hr class="m-0">
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <Button Type="ButtonType.Button"
                                    Color="ButtonColor.Secondary"
                                    Class="w-100">
                                <Icon Name="IconName.Google" Class="me-1" />Google
                            </Button>
                        </div>
                        <div class="col-6">
                            <Button Type="ButtonType.Button"
                                    Color="ButtonColor.Secondary"
                                    Class="w-100">
                                <Icon Name="IconName.Github" Class="me-1" />Github
                            </Button>
                        </div>
                        <div class="col-12">
                            <hr class="m-0">
                        </div>
                        <div class="col-12">
                            <p class="fst-italic m-0">
                                Dont have an account yet?
                                <a href="/register">Sign up.</a>
                            </p>
                        </div>
                    </div>
                </CardBody>
                @* <CardFooter>
                    <p class="fst-italic">
                        Dont have an account yet?
                        <a href="/register">Sign up.</a>
                    </p>
                </CardFooter> *@
            </Card>
        </EditForm>
    </div>
</div>

@code {
    private LoginDto loginModel = new();
    private bool spinnerVisible = false;

    private async Task AttemptLogin()
    {
        
    }
}