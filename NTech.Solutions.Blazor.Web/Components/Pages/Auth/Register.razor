@page "/register"

<PageTitle>Sign in</PageTitle>

<div class="row justify-content-center">
    <div class="col col-sm-8 col-md-7 col-lg-6 col-xl-5">

        <EditForm Model="registerModel" OnValidSubmit="AttemptLogin">
            <DataAnnotationsValidator />

            <Card Class="shadow">
                <CardHeader>
                    <h1>Sign up</h1>
                </CardHeader>
                <CardBody>



                    <div class="row justify-content-center g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <TextInput type="text" @bind-Value="registerModel.Email" id="loginInputEmail" placeholder="name@example.com" />
                                <label for="loginInputEmail" class="form-label">Email</label>
                                <ValidationMessage For="@(() => registerModel.Email)" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <TextInput type="password" @bind-Value="registerModel.Password" id="loginInputPassword" placeholder="Password" />
                                <label for="loginInputPassword" class="form-label">Password</label>
                                <ValidationMessage For="@(() => registerModel.Password)" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <TextInput type="password" @bind-Value="registerModel.PasswordConfirmation" id="loginInputPasswordConfirmation" placeholder="PasswordConfirmation" />
                                <label for="loginInputPasswordConfirmation" class="form-label">Confirm Password</label>
                                <ValidationMessage For="@(() => registerModel.PasswordConfirmation)" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
                            <Button Type="ButtonType.Submit"
                                    Color="ButtonColor.Secondary"
                                    Loading="spinnerVisible"
                                    Disabled="spinnerVisible"
                                    LoadingText="Logging in"
                                    Class="w-100">
                                Register
                            </Button>
                        </div>
                        <div class="col-12">
                            <hr class="m-0">
                        </div>
                        <div class="col-12">
                            <p class="fst-italic m-0">
                                Allready have an account?
                                <a href="/signin">Sign in.</a>
                            </p>
                        </div>
                    </div>
                </CardBody>
            </Card>

        </EditForm>

    </div>
</div>

@code {
    private RegisterDto registerModel = new();
    private bool spinnerVisible = false;

    private async Task AttemptLogin()
    {

    }
}